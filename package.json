{
  "name": "sticky-notes-v2",
  "version": "2.0.0",
  "description": "Desktop knowledge note system - Sticky Notes v2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "marked": "^15.0.0",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.stickynotes.v2",
    "productName": "便签v2",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "database.js",
      "package.json",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": null
    },
    "portable": {
      "artifactName": "StickyNotes-v${version}-portable.exe"
    }
  }
}